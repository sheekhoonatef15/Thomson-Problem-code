          " ", "\"\<N-1 addition\>\""}], "}"}]}], ",", "\n", "  ", 
       RowBox[{"data", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ",", " ", 
       RowBox[{"selected", " ", "=", " ", "\"\<Best overall\>\""}], ",", " ", 
       RowBox[{"display", " ", "=", " ", "\"\<3D\>\""}], ",", " ", 
       RowBox[{"runNumber", " ", "=", " ", "1"}], ",", "\n", "  ", 
       RowBox[{
       "message", " ", "=", 
        " ", "\"\<Ready. Click Optimize to calculate.\>\""}]}], "}"}], ",", 
     "\n", " ", 
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", "\n", "  ", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Fast Thomson Problem\>\"", ",", " ", "18", ",", " ", 
           "Bold"}], "]"}], ",", "\n", "  ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Charges N: \>\"", ",", " ", 
            RowBox[{"InputField", "[", 
             RowBox[{
              RowBox[{"Dynamic", "[", "n", "]"}], ",", " ", "Number", ",", 
              " ", 
              RowBox[{"FieldSize", " ", "->", " ", "5"}]}], "]"}], ",", "\n", 
            "    ", 
            RowBox[{"Spacer", "[", "15", "]"}], ",", 
            " ", "\"\<Starts per method: \>\"", ",", " ", 
            RowBox[{"InputField", "[", 
             RowBox[{
              RowBox[{"Dynamic", "[", "starts", "]"}], ",", " ", "Number", ",",
               " ", 
              RowBox[{"FieldSize", " ", "->", " ", "4"}]}], "]"}], ",", "\n", 
            "    ", 
            RowBox[{"Spacer", "[", "15", "]"}], ",", 
            " ", "\"\<Max iterations: \>\"", ",", " ", 
            RowBox[{"InputField", "[", 
             RowBox[{
              RowBox[{"Dynamic", "[", "iters", "]"}], ",", " ", "Number", ",",
               " ", 
              RowBox[{"FieldSize", " ", "->", " ", "5"}]}], "]"}]}], "}"}], 
          "]"}], ",", "\n", "  ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Gradient tolerance: \>\"", ",", " ", 
            RowBox[{"InputField", "[", 
             RowBox[{
              RowBox[{"Dynamic", "[", "tol", "]"}], ",", " ", "Number", ",", 
              " ", 
              RowBox[{"FieldSize", " ", "->", " ", "8"}]}], "]"}], ",", "\n", 
            "    ", 
            RowBox[{"Spacer", "[", "15", "]"}], ",", " ", "\"\<Seed: \>\"", ",",
             " ", 
            RowBox[{"InputField", "[", 
             RowBox[{
              RowBox[{"Dynamic", "[", "seed", "]"}], ",", " ", "Number", ",", 
              " ", 
              RowBox[{"FieldSize", " ", "->", " ", "7"}]}], "]"}]}], "}"}], 
          "]"}], ",", "\n", "  ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Methods: \>\"", ",", " ", 
            RowBox[{"CheckboxBar", "[", 
             RowBox[{
              RowBox[{"Dynamic", "[", "enabled", "]"}], ",", "\n", "    ", 
              RowBox[{"{", 
               
               RowBox[{"\"\<Random\>\"", ",", " ", "\"\<N+1 removal\>\"", ",",
                 " ", "\"\<N-1 addition\>\""}], "}"}]}], "]"}]}], "}"}], 
          "]"}], ",", "\n", "  ", 
         RowBox[{"Button", "[", 
          RowBox[{"\"\<Optimize\>\"", ",", "\n", "   ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"IntegerQ", "[", "n", "]"}], " ", "&&", " ", 
                RowBox[{"2", " ", "<=", " ", "n", " ", "<=", " ", "300"}], 
                " ", "&&", " ", 
                RowBox[{"IntegerQ", "[", "starts", "]"}], " ", "&&", "\n", 
                "      ", 
                RowBox[{
                "1", " ", "<=", " ", "starts", " ", "<=", " ", "100"}], " ", "&&",
                 " ", 
                RowBox[{"IntegerQ", "[", "iters", "]"}], " ", "&&", " ", 
                RowBox[{
                "1", " ", "<=", " ", "iters", " ", "<=", " ", "100000"}], " ",
                 "&&", "\n", "      ", 
                RowBox[{"NumericQ", "[", "tol", "]"}], " ", "&&", " ", 
                RowBox[{"tol", " ", ">", " ", "0"}], " ", "&&", " ", 
                RowBox[{"IntegerQ", "[", "seed", "]"}], " ", "&&", " ", 
                RowBox[{
                 RowBox[{"Length", "[", "enabled", "]"}], " ", ">", " ", 
                 "0"}]}], ")"}]}], ",", "\n", "    ", 
             RowBox[{
             "message", " ", "=", 
              " ", "\"\<Check inputs: N >= 2, starts >= 1, iterations >= 1, \
positive tolerance and at least one method.\>\""}], ",", "\n", "    ", 
             RowBox[{
              RowBox[{"message", " ", "=", " ", "\"\<Optimizing...\>\""}], ";",
               "\n", "    ", 
              RowBox[{"data", " ", "=", " ", 
               RowBox[{"runFast", "[", 
                RowBox[{
                "n", ",", " ", "enabled", ",", " ", "starts", ",", " ", 
                 "iters", ",", " ", 
                 RowBox[{"N", "[", "tol", "]"}], ",", " ", "seed"}], "]"}]}], 
              ";", "\n", "    ", 
              RowBox[{"selected", " ", "=", " ", "\"\<Best overall\>\""}], ";",
               " ", 
              RowBox[{"runNumber", " ", "=", " ", "1"}], ";", "\n", "    ", 
              RowBox[{
              "message", " ", "=", 
               " ", "\"\<Finished. Visualization changes do not rerun \
optimization.\>\""}]}]}], "\n", "   ", "]"}], ",", " ", 
           RowBox[{"Method", " ", "->", " ", "\"\<Queued\>\""}], ",", " ", 
           RowBox[{"ImageSize", " ", "->", " ", "140"}]}], "]"}], ",", "\n", 
         "  ", 
         RowBox[{"Dynamic", "[", "message", "]"}], ",", "\n", "  ", 
         RowBox[{"Divider", "[", "]"}], ",", "\n", "  ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Method: \>\"", ",", " ", 
            RowBox[{"PopupMenu", "[", 
             RowBox[{
              RowBox[{"Dynamic", "[", "selected", "]"}], ",", "\n", "    ", 
              RowBox[{"Dynamic", "[", 
               RowBox[{"Prepend", "[", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Length", "[", "data", "]"}], " ", ">", " ", 
                    "0"}], ",", " ", 
                   RowBox[{"Lookup", "[", 
                    RowBox[{"data", ",", " ", "\"\<Method\>\""}], "]"}], ",", 
                   " ", "enabled"}], "]"}], ",", 
                 " ", "\"\<Best overall\>\""}], "]"}], "]"}]}], "]"}], ",", 
            "\n", "    ", 
            RowBox[{"Spacer", "[", "15", "]"}], ",", " ", "\"\<View: \>\"", ",",
             " ", 
            RowBox[{"PopupMenu", "[", 
             RowBox[{
              RowBox[{"Dynamic", "[", "display", "]"}], ",", "\n", "      ", 
              RowBox[{"{", 
               
               RowBox[{"\"\<3D\>\"", ",", " ", "\"\<Convergence\>\"", ",", 
                " ", "\"\<Method comparison\>\"", ",", 
                " ", "\"\<All runs\>\""}], "}"}]}], "]"}], ",", "\n", "    ", 
            RowBox[{"Spacer", "[", "15", "]"}], ",", " ", "\"\<Run: \>\"", ",",
             " ", 
            RowBox[{"SetterBar", "[", 
             RowBox[{
              RowBox[{"Dynamic", "[", "runNumber", "]"}], ",", " ", 
              RowBox[{"Range", "[", 
               RowBox[{"1", ",", " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"1", ",", " ", "starts"}], "]"}]}], "]"}]}], "]"}]}],
            "}"}], "]"}], ",", "\n", "  ", 
         RowBox[{"Dynamic", "[", "\n", "   ", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "data", "]"}], " ", "==", " ", "0"}], ",",
              " ", 
             RowBox[{"Style", "[", 
              RowBox[{"\"\<No results yet.\>\"", ",", " ", "Gray"}], "]"}], ",",
              "\n", "    ", 
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "chosen", ",", " ", "r", ",", " ", "p", ",", " ", 
                 "energies"}], "}"}], ",", "\n", "     ", 
               RowBox[{
                RowBox[{"chosen", " ", "=", " ", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                   "selected", " ", "==", " ", "\"\<Best overall\>\""}], ",", 
                   "\n", "       ", 
                   RowBox[{"First", "[", 
                    RowBox[{"MinimalBy", "[", 
                    RowBox[{"data", ",", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", "\"\<Best\>\"", "]"}], 
                    "[", "\"\<Energy\>\"", "]"}], " ", "&"}]}], "]"}], "]"}], 
                   ",", "\n", "       ", 
                   RowBox[{"SelectFirst", "[", 
                    RowBox[{"data", ",", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", "\"\<Method\>\"", "]"}], " ", "==", " ",
                     "selected"}], " ", "&"}], ",", " ", 
                    RowBox[{"First", "[", "data", "]"}]}], "]"}]}], "]"}]}], ";",
                 "\n", "     ", 
                RowBox[{"r", " ", "=", " ", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                   "selected", " ", "==", " ", "\"\<Best overall\>\""}], ",", 
                   " ", 
                   RowBox[{"chosen", "[", "\"\<Best\>\"", "]"}], ",", "\n", 
                   "       ", 
                   RowBox[{
                    RowBox[{"chosen", "[", "\"\<Runs\>\"", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"Min", "[", 
                    RowBox[{"runNumber", ",", " ", 
                    RowBox[{"Length", "[", 
                    RowBox[{"chosen", "[", "\"\<Runs\>\"", "]"}], "]"}]}], 
                    "]"}], "]"}], "]"}]}], "]"}]}], ";", "\n", "     ", 
                RowBox[{"p", " ", "=", " ", 
                 RowBox[{"r", "[", "\"\<Points\>\"", "]"}]}], ";", "\n", 
                "     ", 
                RowBox[{"Column", "[", 
                 RowBox[{"{", "\n", "       ", 
                  RowBox[{
                   RowBox[{"Row", "[", 
                    RowBox[{"{", 
                    RowBox[{"\"\<Method: \>\"", ",", " ", 
                    RowBox[{"chosen", "[", "\"\<Method\>\"", "]"}], ",", 
                    " ", "\"\<    Energy: \>\"", ",", "\n", "         ", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"r", "[", "\"\<Energy\>\"", "]"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"14", ",", " ", "9"}], "}"}]}], "]"}], ",", 
                    " ", "\"\<    Iterations: \>\"", ",", " ", 
                    RowBox[{"r", "[", "\"\<Iterations\>\"", "]"}]}], "}"}], 
                    "]"}], ",", "\n", "       ", 
                   RowBox[{"Switch", "[", 
                    RowBox[{
                    "display", ",", "\n", "        ", "\"\<3D\>\"", ",", " ", 
                    RowBox[{"Graphics3D", "[", 
                    RowBox[{
                    RowBox[{"{", "\n", "          ", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Opacity", "[", "0.12", "]"}], ",", " ", 
                    "LightBlue", ",", " ", 
                    RowBox[{"Sphere", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", 
                    " ", "1"}], "]"}]}], "}"}], ",", "\n", "          ", 
                    RowBox[{"{", 
                    RowBox[{"Red", ",", " ", 
                    RowBox[{"PointSize", "[", "0.018", "]"}], ",", " ", 
                    RowBox[{"Point", "[", "p", "]"}]}], "}"}]}], "}"}], ",", 
                    "\n", "          ", 
                    RowBox[{"Boxed", " ", "->", " ", "False"}], ",", " ", 
                    RowBox[{"SphericalRegion", " ", "->", " ", "True"}], ",", 
                    "\n", "          ", 
                    RowBox[{"PlotRange", " ", "->", " ", "1.15"}], ",", " ", 
                    RowBox[{"ImageSize", " ", "->", " ", "480"}]}], "]"}], ",",
                     "\n", "        ", "\"\<Convergence\>\"", ",", " ", 
                    RowBox[{"ListLinePlot", "[", 
                    RowBox[{
                    RowBox[{"r", "[", "\"\<History\>\"", "]"}], ",", " ", 
                    RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", 
                    "          ", 
                    RowBox[{"FrameLabel", " ", "->", " ", 
                    RowBox[{"{", 
                    
                    RowBox[{"\"\<Accepted step\>\"", ",", 
                    " ", "\"\<Coulomb energy\>\""}], "}"}]}], ",", " ", 
                    RowBox[{"ImageSize", " ", "->", " ", "480"}]}], "]"}], ",",
                     "\n", "        ", "\"\<Method comparison\>\"", ",", " ", 
                    RowBox[{"BarChart", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", "\"\<Best\>\"", "]"}], 
                    "[", "\"\<Energy\>\"", "]"}], " ", "&"}], " ", "/@", " ", 
                    "data"}], ",", "\n", "          ", 
                    RowBox[{"ChartLabels", " ", "->", " ", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"data", ",", " ", "\"\<Method\>\""}], "]"}]}], ",",
                     " ", 
                    RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", 
                    "          ", 
                    RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
                    RowBox[{"ImageSize", " ", "->", " ", "480"}]}], "]"}], ",",
                     "\n", "        ", "\"\<All runs\>\"", ",", " ", 
                    RowBox[{"ListPlot", "[", 
                    RowBox[{
                    RowBox[{"MapIndexed", "[", "\n", "           ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{
                    RowBox[{"First", "[", "#2", "]"}], ",", " ", 
                    RowBox[{"Length", "[", 
                    RowBox[{"#1", "[", "\"\<Runs\>\"", "]"}], "]"}]}], "]"}], 
                    ",", "\n", "              ", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{
                    RowBox[{"#1", "[", "\"\<Runs\>\"", "]"}], ",", 
                    " ", "\"\<Energy\>\""}], "]"}]}], "}"}], "]"}], " ", 
                    "&"}], ",", " ", "data"}], "]"}], ",", "\n", 
                    "           ", 
                    RowBox[{"PlotLegends", " ", "->", " ", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"data", ",", " ", "\"\<Method\>\""}], "]"}]}], ",",
                     "\n", "           ", 
                    RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
                    RowBox[{"ImageSize", " ", "->", " ", "480"}]}], "]"}]}], 
                    "\n", "       ", "]"}]}], "\n", "     ", "}"}], "]"}]}]}],
               "\n", "    ", "]"}]}], "\n", "   ", "]"}], ",", " ", 
           RowBox[{"TrackedSymbols", " ", ":>", " ", 
            RowBox[{"{", 
             RowBox[{
             "data", ",", " ", "selected", ",", " ", "display", ",", " ", 
              "runNumber"}], "}"}]}]}], "]"}]}], "\n", " ", "}"}], ",", " ", 
       RowBox[{"Spacings", " ", "->", " ", "1.3"}]}], "]"}]}], "\n", "]"}], 
